# ════════════════════════════════════════════════════════════
#  AvatarGuru.ai — Docker Environment Variables
#
#  INSTRUCTIONS:
#    1. Copy this file to .env.docker
#    2. Fill in all values marked with <FILL_IN>
#    3. NEVER commit .env.docker to git
# ════════════════════════════════════════════════════════════


# ── Groq API ─────────────────────────────────────────────
# Comma-separated keys for automatic rotation
GROQ_API_KEY= gsk_4DPhTW2NscpswjNzP3uxWGdyb3FY22w6GT4tT2kNzWgvd94uWrZ5k_GKPT157qceA5o1GOHa3bWGdyb3FYIaxwnqj55pQSM2SWmyWzCJFY

# ── Serper (Image Search) ─────────────────────────────────
SERPER_API_KEY=49d79b4e7f821b6f23c5b930bbb856b19d35dcc7
SERPER_URL=https://google.serper.dev/images
CALLS=4
PERIOD=1

# ── MongoDB ───────────────────────────────────────────────
# (URL is overridden in docker-compose.yml to use the service hostname)
MONGO_DB=neurolearn
MONGODB_COLLECTION=files
GRIDFS_COLLECTION=tts_audio

# ── Hugging Face ──────────────────────────────────────────
HF_TOKEN=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
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── Groq Models ───────────────────────────────────────────
SUMMARY_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3-turbo

# ── Groq TTS (if using cloud TTS instead of local Parler) ─
# TTS_VOICE=<voice_name>

# ── Ingest Config ─────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── ML Model Host Paths ───────────────────────────────────
# Set these to the absolute paths on your SERVER where the models live.
# The backend container will bind-mount them read-only.
EMBEDDING_MODEL_HOST_PATH=/data/models/bge-base-en-v1.5
TTS_MODEL_HOST_PATH=/data/models/parler_tts_mini_v1

# ── Flask ─────────────────────────────────────────────────
FLASK_ENV=production

# ── Preprocess (optional, only needed if running preprocess.py) ──
PREPROCESS_PDF_PATH=/app/uploads/your_file.pdf
PREPROCESS_BOARD=10th
PREPROCESS_SUBJECT=History
PREPROCESS_LESSON=L4
PREPROCESS_TITLE=Lesson Title
PREPROCESS_START_PAGE=1
PREPROCESS_END_PAGE=10
